import {
  activate,
  call,
  init,
  kinds,
  methods,
  normalize_inbound,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

/** Read a fixture JSON body from the test fixtures directory. */
pub fn fixture_body(fs: HarnessFs, name: any) {
  return fs.read_text(fs.source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/**
 * Compute the Buildkite webhook signature header value for a body.
 *
 * The signed message is `"<timestamp>.<raw_body>"`, HMAC-SHA256 keyed by the
 * webhook token. Mirrors `__verify_signature` in src/lib.harn.
 */
pub fn sign(token: any, body: any, timestamp: any) {
  const signature = hmac_sha256(to_string(token), to_string(timestamp) + "." + body)
  return "timestamp=" + to_string(timestamp) + ",signature=" + signature
}

/** Current unix timestamp as an integer (within the freshness window). */
pub fn now_ts(clock: HarnessClock) {
  return to_int(clock.timestamp())
}

/** Build a raw inbound envelope signed with the X-Buildkite-Signature scheme. */
pub fn signed_raw(clock: HarnessClock, token: any, body: any, event: any, timestamp: any = nil) {
  const ts = timestamp ?? now_ts(clock)
  return {
    body_text: body,
    headers: {"x-buildkite-event": event, "x-buildkite-signature": sign(token, body, ts)},
  }
}

/** Build a raw inbound envelope using the simpler X-Buildkite-Token scheme. */
pub fn token_raw(token: any, body: any, event: any) {
  return {body_text: body, headers: {"x-buildkite-event": event, "x-buildkite-token": token}}
}

/** Build a signed raw inbound envelope from a named fixture. */
pub fn fixture_raw(
  harness: {clock: HarnessClock, fs: HarnessFs},
  name: any,
  token: any,
  event: any,
  timestamp: any = nil,
) {
  return signed_raw(harness.clock, token, fixture_body(harness.fs, name), event, timestamp)
}

pub fn assert_buildkite_interface(harness: Harness) {
  shutdown(harness)
  expect_eq(provider_id(), "buildkite", "provider id")
  expect_eq(kinds()[0], "webhook", "webhook kind")
  expect_eq(payload_schema().harn_schema_name, "BuildkiteEventPayload", "payload schema name")
  const mutate = __method_meta(methods(), "job.retry")
  expect(mutate.requires_approval, "job.retry requires approval")
  const read = __method_meta(methods(), "build.get")
  expect(!read.requires_approval, "build.get does not require approval")
  const initialized = init(harness, {webhook_token: "test-secret"})
  expect(initialized.initialized, "init stores state")
  const activated = activate(
    harness,
    [{id: "primary", path: "/buildkite/events", secrets: {webhook_token: "test-secret"}}],
  )
  expect_eq(activated.bindings, 1, "activate counts bindings")
}

fn __method_meta(method_list: any, name: any) {
  for entry in method_list {
    if entry.name == name {
      return entry
    }
  }
  return {name: name, requires_approval: false}
}

pub fn buildkite_call(harness: Harness, method: any, args: any) {
  return call(harness, method, args)
}

pub fn buildkite_normalize(harness: Harness, raw: any) {
  return normalize_inbound(harness, raw)
}

/**
 * Require that a smoke-test condition holds. Helper `fn`s are not test
 * pipelines, so `assert` does not belong here (HARN-LNT-025).
 */
fn expect(condition: any, message: any = "expectation failed") {
  require condition, message
}

/** Require that two smoke-test values are equal, reporting both on failure. */
fn expect_eq(actual: any, expected: any, message: any = "values differ") {
  require actual == expected,
    message + ": expected " + to_string(expected) + ", got "
    + to_string(actual)
}
